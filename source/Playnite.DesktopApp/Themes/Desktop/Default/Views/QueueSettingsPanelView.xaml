<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type QueueSettingsPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type QueueSettingsPanel}">
                    <Border Width="360"
                            Background="{DynamicResource WindowBackgourndBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="16"
                            TextElement.Foreground="{DynamicResource TextBrush}"
                            TextElement.FontFamily="{DynamicResource FontFamily}"
                            TextElement.FontSize="{DynamicResource FontSize}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCQueueSettingsTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16" />

                                <GroupBox Header="{DynamicResource LOCQueueBasicsTitle}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{DynamicResource LOCQueueVisibleCount}" />
                                        <TextBox Text="{Binding Settings.VisibleCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,10" />

                                        <TextBlock Text="{DynamicResource LOCQueueDateSource}" />
                                        <ComboBox ItemsSource="{Binding DateSources, RelativeSource={RelativeSource TemplatedParent}}"
                                                  SelectedItem="{Binding Settings.DateSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueueCompletionStatusesTitle}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{DynamicResource LOCQueuePlayingStatus}" />
                                        <ComboBox ItemsSource="{Binding CompletionStatuses, RelativeSource={RelativeSource TemplatedParent}}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding Settings.PlayingStatusId, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4,0,10" />

                                        <TextBlock Text="{DynamicResource LOCQueueTerminalStatuses}" />
                                        <ItemsControl ItemsSource="{Binding TerminalStatusSelections, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4,0,0">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="{DynamicResource LOCRemoveLabel}"
                                                                Margin="6,0,0,0"
                                                                Command="{Binding RemoveTerminalStatusCommand, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                CommandParameter="{Binding}" />
                                                        <ComboBox ItemsSource="{Binding CompletionStatuses, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                  SelectedValuePath="Id"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValue="{Binding StatusId, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right"
                                                    Content="{DynamicResource LOCAddLabel}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding AddTerminalStatusCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ComboBox ItemsSource="{Binding CompletionStatuses, RelativeSource={RelativeSource TemplatedParent}}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"
                                                      SelectedValue="{Binding NewTerminalStatusId, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueuePriorityRules}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <ItemsControl ItemsSource="{Binding Settings.PriorityRules, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource NormalBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="0,0,0,8"
                                                            Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                    <Button Content="{DynamicResource LOCMoveUpLabel}"
                                                                            Command="{Binding MovePriorityRuleUpCommand, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Content="{DynamicResource LOCMoveDownLabel}"
                                                                            Margin="4,0,0,0"
                                                                            Command="{Binding MovePriorityRuleDownCommand, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Content="{DynamicResource LOCRemoveLabel}"
                                                                            Margin="4,0,0,0"
                                                                            Command="{Binding RemovePriorityRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                <ComboBox ItemsSource="{Binding PriorityFields, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                          SelectedItem="{Binding Field, UpdateSourceTrigger=PropertyChanged}"
                                                                          Width="120" />
                                                            </DockPanel>

                                                            <TextBlock Text="{DynamicResource LOCQueuePriorityValue}" Margin="0,8,0,0" />
                                                            <ComboBox ItemsSource="{Binding PriorityValueOptions, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                      SelectedValuePath="Id"
                                                                      DisplayMemberPath="Name"
                                                                      SelectedValue="{Binding ValueId, UpdateSourceTrigger=PropertyChanged}" />

                                                            <TextBlock Text="{DynamicResource LOCQueuePriorityBoolValue}" Margin="0,8,0,0" />
                                                            <ComboBox ItemsSource="{Binding BoolValueOptions, RelativeSource={RelativeSource AncestorType={x:Type QueueSettingsPanel}}}"
                                                                      SelectedValuePath="Value"
                                                                      DisplayMemberPath="Name"
                                                                      SelectedValue="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="{DynamicResource LOCQueueAddPriorityRule}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding AddPriorityRuleCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueueBuffersTitle}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferType}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,8,4" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{DynamicResource LOCQueuePushIfPlayingShort}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       Margin="0,0,12,4" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{DynamicResource LOCQueueRecentCompletedCount}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Right"
                                                       Margin="0,0,0,4" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.StyleBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.StyleBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferSeries}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.SeriesBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.SeriesBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferDeveloper}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.DeveloperBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.DeveloperBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferGenre}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.GenreBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.GenreBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <TextBlock Text="{DynamicResource LOCQueueRecentCompletedCountHint}"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueueGroupingTitle}">
                                    <StackPanel Margin="8">
                                        <CheckBox Content="{DynamicResource LOCQueueGroupByDeveloper}"
                                                  IsChecked="{Binding Settings.GroupByDeveloper, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <CheckBox Content="{DynamicResource LOCQueueGroupBySeries}"
                                                  IsChecked="{Binding Settings.GroupBySeries, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
