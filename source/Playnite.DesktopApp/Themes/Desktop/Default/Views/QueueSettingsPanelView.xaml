<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:pcon="clr-namespace:Playnite.Converters;assembly=Playnite"
                    xmlns:qnconv="clr-namespace:Playnite.DesktopApp.QueueConverters;assembly=Playnite.DesktopApp"
                    mc:Ignorable="d">

    <qnconv:QueuePriorityRuleSummaryConverter x:Key="QueuePriorityRuleSummaryConverter" />

    <Style TargetType="{x:Type QueueSettingsPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type QueueSettingsPanel}">
                    <Border Width="360"
                            Background="{DynamicResource WindowBackgourndBrush}"
                            BorderBrush="{DynamicResource NormalBorderBrush}"
                            BorderThickness="1,0,0,0"
                            Padding="16"
                            TextElement.Foreground="{DynamicResource TextBrush}"
                            TextElement.FontFamily="{DynamicResource FontFamily}"
                            TextElement.FontSize="{DynamicResource FontSize}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCQueueSettingsTitle}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,16" />

                                <GroupBox Header="{DynamicResource LOCQueueBasicsTitle}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{DynamicResource LOCQueueVisibleCount}" />
                                        <TextBox Text="{Binding Settings.VisibleCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,10" />

                                        <TextBlock Text="{DynamicResource LOCQueueDateSource}" />
                                        <ComboBox ItemsSource="{Binding DateSources, RelativeSource={RelativeSource TemplatedParent}}"
                                                  SelectedItem="{Binding Settings.DateSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueueCompletionStatusesTitle}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{DynamicResource LOCQueuePlayingStatus}" />
                                        <ComboBox ItemsSource="{Binding PlayingStatusPickerItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="Name"
                                                  SelectedValue="{Binding Settings.PlayingStatusId, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,4,0,10" />

                                        <TextBlock Text="{DynamicResource LOCQueueTerminalStatuses}" />
                                        <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="{DynamicResource LOCAddLabel}"
                                                    Margin="8,0,0,0"
                                                    MinWidth="72"
                                                    Command="{Binding AddTerminalStatusCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ComboBox ItemsSource="{Binding TerminalAddPickerItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Name"
                                                      SelectedValue="{Binding NewTerminalStatusId, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding TerminalStatusRows, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                                        <Button DockPanel.Dock="Right"
                                                                FontFamily="Marlett"
                                                                Content="r"
                                                                Width="26"
                                                                Padding="0"
                                                                ToolTip="{DynamicResource LOCRemoveLabel}"
                                                                Margin="8,0,0,0"
                                                                Command="{Binding RemoveCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueuePriorityRules}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="{DynamicResource LOCAddLabel}"
                                                    Margin="10,0,0,0"
                                                    MinWidth="72"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding AddPriorityRuleCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCQueuePriorityProperty}" />
                                                <ComboBox ItemsSource="{Binding PriorityFields, RelativeSource={RelativeSource TemplatedParent}}"
                                                          SelectedItem="{Binding NewPriorityField, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,4,0,0" />

                                                <StackPanel Margin="0,10,0,0"
                                                            Visibility="{Binding ShowNewPriorityIdValueEditor, RelativeSource={RelativeSource TemplatedParent}, Converter={pcon:BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                                    <TextBlock Text="{DynamicResource LOCQueuePriorityValue}" />
                                                    <ComboBox x:Name="PART_NewPriorityValueCombo"
                                                              Margin="0,4,0,0"
                                                              IsEditable="True"
                                                              StaysOpenOnEdit="True"
                                                              IsTextSearchEnabled="False"
                                                              MaxDropDownHeight="280"
                                                              DisplayMemberPath="Name"
                                                              ItemsSource="{Binding NewPriorityFilteredValueOptions, RelativeSource={RelativeSource TemplatedParent}}"
                                                              SelectedItem="{Binding NewPrioritySelectedOption, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                              Text="{Binding NewPriorityValueSearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Margin="0,10,0,0"
                                                            Visibility="{Binding ShowNewPriorityBoolEditor, RelativeSource={RelativeSource TemplatedParent}, Converter={pcon:BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                                    <TextBlock Text="{DynamicResource LOCQueuePriorityValue}" />
                                                    <ComboBox ItemsSource="{Binding PriorityBoolPickOptions, RelativeSource={RelativeSource TemplatedParent}}"
                                                              SelectedValuePath="Value"
                                                              DisplayMemberPath="Name"
                                                              SelectedValue="{Binding NewPriorityBoolValue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding PriorityRuleRows, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                            <Button FontFamily="Marlett"
                                                                    Content="5"
                                                                    Width="26"
                                                                    Padding="0"
                                                                    ToolTip="{DynamicResource LOCMoveUpLabel}"
                                                                    Command="{Binding MoveUpCommand}" />
                                                            <Button FontFamily="Marlett"
                                                                    Content="6"
                                                                    Width="26"
                                                                    Padding="0"
                                                                    Margin="4,0,0,0"
                                                                    ToolTip="{DynamicResource LOCMoveDownLabel}"
                                                                    Command="{Binding MoveDownCommand}" />
                                                            <Button FontFamily="Marlett"
                                                                    Content="r"
                                                                    Width="26"
                                                                    Padding="0"
                                                                    Margin="4,0,0,0"
                                                                    ToolTip="{DynamicResource LOCRemoveLabel}"
                                                                    Command="{Binding RemoveCommand}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Rule, Converter={StaticResource QueuePriorityRuleSummaryConverter}}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueueBuffersTitle}" Margin="0,0,0,12">
                                    <StackPanel Margin="8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferType}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,8,4" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{DynamicResource LOCQueuePushIfPlayingShort}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       Margin="0,0,12,4" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{DynamicResource LOCQueueRecentCompletedCount}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Right"
                                                       Margin="0,0,0,4" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.StyleBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.StyleBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferSeries}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.SeriesBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.SeriesBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferDeveloper}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.DeveloperBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.DeveloperBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource LOCQueueBufferGenre}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <CheckBox Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,12,0"
                                                      ToolTip="{DynamicResource LOCQueuePushIfPlaying}"
                                                      IsChecked="{Binding Settings.GenreBuffer.PushIfPlayingMatches, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Settings.GenreBuffer.RecentCompletedCount, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <TextBlock Text="{DynamicResource LOCQueueRecentCompletedCountHint}"
                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{DynamicResource LOCQueueGroupingTitle}">
                                    <StackPanel Margin="8">
                                        <CheckBox Content="{DynamicResource LOCQueueGroupByDeveloper}"
                                                  IsChecked="{Binding Settings.GroupByDeveloper, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <CheckBox Content="{DynamicResource LOCQueueGroupBySeries}"
                                                  IsChecked="{Binding Settings.GroupBySeries, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
