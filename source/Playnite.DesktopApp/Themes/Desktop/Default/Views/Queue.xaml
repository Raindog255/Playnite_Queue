<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:p="clr-namespace:Playnite;assembly=Playnite"
                    xmlns:conv="clr-namespace:Playnite.Converters;assembly=Playnite"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Queue}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Queue}">
                    <DockPanel Background="{DynamicResource ControlBackgroundBrush}"
                               TextElement.Foreground="{DynamicResource TextBrush}"
                               TextElement.FontFamily="{DynamicResource FontFamily}"
                               TextElement.FontSize="{DynamicResource FontSize}">
                        <QueueSettingsPanel DockPanel.Dock="Right" />

                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="20"
                                          Visibility="{Binding IsEmpty, Converter={conv:InvertedBooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding QueueGames}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <GameListItem Style="{StaticResource GridViewItemTemplate}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={conv:BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource LOCQueueEmptyTitle}"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOCQueueEmptyHint}"
                                           Margin="0,12,0,0"
                                           MaxWidth="420"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
