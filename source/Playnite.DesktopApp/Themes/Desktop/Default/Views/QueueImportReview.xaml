<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Playnite.Converters;assembly=Playnite">

    <Style x:Key="QueueImportReviewCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="{x:Type QueueImportReview}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type QueueImportReview}">
                    <DockPanel Background="{DynamicResource ControlBackgroundBrush}"
                               TextElement.Foreground="{DynamicResource TextBrush}"
                               TextElement.FontFamily="{DynamicResource FontFamily}"
                               TextElement.FontSize="{DynamicResource FontSize}">
                        <Border DockPanel.Dock="Right"
                                Width="320"
                                Padding="16"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                Background="{DynamicResource PopupBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCQueueImportReviewSettingsTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />
                                <TextBlock Text="{Binding Summary}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           Margin="0,0,0,12" />
                                <Button Content="{DynamicResource LOCQueueImportReviewCommit}"
                                        Margin="0,0,0,8"
                                        Command="{Binding CommitCommand}" />
                                <Button Content="{DynamicResource LOCQueueImportReviewDiscard}"
                                        Margin="0,0,0,8"
                                        Command="{Binding DiscardCommand}" />
                                <Button Content="{DynamicResource LOCQueueImportReviewRefresh}"
                                        Command="{Binding RefreshCommand}" />
                                <TextBlock Text="{DynamicResource LOCQueueImportReviewHint}"
                                           TextWrapping="Wrap"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="20"
                                          Visibility="{Binding IsEmpty, Converter={conv:InvertedBooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{DynamicResource LOCQueueImportReviewHeader}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrushDarker}">
                                            <Run Text="{Binding ReviewCount, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{DynamicResource LOCQueueImportReviewNeedsReviewSuffix}" />
                                        </TextBlock>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource QueueImportReviewCardBorder}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding MatchSummary}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GlyphBrush}" />
                                                            <TextBlock FontSize="14"
                                                                       FontWeight="SemiBold">
                                                                <Run Text="{DynamicResource LOCQueueImportReviewRowPrefix}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding RowNumber, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="{DynamicResource LOCQueueImportReviewOriginalName}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                                       Text="{Binding OriginalName}"
                                                                       TextWrapping="Wrap" />

                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                       Margin="0,4,0,0"
                                                                       Text="{DynamicResource LOCQueueImportReviewSanitizedName}"
                                                                       Foreground="{DynamicResource TextBrushDarker}"
                                                                       Visibility="{Binding HasSanitizeProposal, Converter={conv:BooleanToVisibilityConverter}}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                                       Margin="0,4,0,0"
                                                                       Text="{Binding SanitizedName}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasSanitizeProposal, Converter={conv:BooleanToVisibilityConverter}}" />
                                                        </Grid>

                                                        <TextBlock Text="{DynamicResource LOCQueueImportReviewManualMatch}"
                                                                   Margin="0,8,0,4"
                                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                                 Margin="0,0,0,4" />
                                                        <ListBox ItemsSource="{Binding SearchResults}"
                                                                 SelectedItem="{Binding SelectedMatch, Mode=TwoWay}"
                                                                 Margin="0,0,0,8">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2" />
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="{DynamicResource LOCQueueImportReviewUseMatch}"
                                                                    Command="{Binding UseMatchCommand}"
                                                                    IsEnabled="{Binding HasSelectedMatch}"
                                                                    Margin="0,0,8,0" />
                                                            <Button Content="{DynamicResource LOCQueueImportReviewCreateGame}"
                                                                    Command="{Binding CreateNewGameCommand}"
                                                                    Margin="0,0,8,0" />
                                                            <Button Content="{DynamicResource LOCQueueImportReviewDismissRow}"
                                                                    Command="{Binding DismissCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={conv:BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource LOCQueueImportReviewEmptyTitle}"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOCQueueImportReviewEmptyHint}"
                                           Margin="0,12,0,0"
                                           MaxWidth="440"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
