<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:p="clr-namespace:Playnite;assembly=Playnite"
                    xmlns:san="clr-namespace:Playnite.LibrarySanitizer;assembly=Playnite"
                    xmlns:conv="clr-namespace:Playnite.Converters;assembly=Playnite"
                    xmlns:pcon="clr-namespace:Playnite.Converters;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Card chrome shared by every action template. Defines the per-card
         border + padding + background so type-specific templates can stay
         focused on the body content. -->
    <Style x:Key="SanitizerCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="{x:Type LibrarySanitizer}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type LibrarySanitizer}">
                    <DockPanel Background="{DynamicResource ControlBackgroundBrush}"
                               TextElement.Foreground="{DynamicResource TextBrush}"
                               TextElement.FontFamily="{DynamicResource FontFamily}"
                               TextElement.FontSize="{DynamicResource FontSize}">
                        <LibrarySanitizerSettingsPanel DockPanel.Dock="Right" />

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="20"
                                          Visibility="{Binding IsEmpty, Converter={conv:InvertedBooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{DynamicResource LOCSanitizerHeader}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrushDarker}">
                                            <Run Text="{Binding ActionCount, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{DynamicResource LOCSanitizerActionCountSuffix}" />
                                        </TextBlock>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.Resources>

                                            <!-- Sanitize action card: name diff + apply/dismiss/edit -->
                                            <DataTemplate DataType="{x:Type san:SanitizeAction}">
                                                <Border Style="{StaticResource SanitizerCardBorder}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{DynamicResource LOCSanitizerActionSanitize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GlyphBrush}" />
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="{DynamicResource LOCSanitizerBeforeLabel}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                                       Text="{Binding OriginalName}"
                                                                       TextWrapping="Wrap" />

                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                       Margin="0,4,0,0"
                                                                       Text="{DynamicResource LOCSanitizerAfterLabel}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" />
                                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                                     Margin="0,4,0,0"
                                                                     Text="{Binding ProposedName, UpdateSourceTrigger=PropertyChanged}" />

                                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                                       Margin="0,4,0,0"
                                                                       Text="{DynamicResource LOCSanitizerSortLabel}"
                                                                       Foreground="{DynamicResource TextBrushDarker}"
                                                                       Visibility="{Binding ShowSortingName, Converter={conv:BooleanToVisibilityConverter}}" />
                                                            <TextBox Grid.Row="2" Grid.Column="1"
                                                                     Margin="0,4,0,0"
                                                                     Text="{Binding ProposedSortingName, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                     Visibility="{Binding ShowSortingName, Converter={conv:BooleanToVisibilityConverter}}" />

                                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                                       Margin="0,4,0,0"
                                                                       Text="{DynamicResource LOCSanitizerVersionLabel}"
                                                                       Foreground="{DynamicResource TextBrushDarker}"
                                                                       Visibility="{Binding ShowVersion, Converter={conv:BooleanToVisibilityConverter}}" />
                                                            <TextBox Grid.Row="3" Grid.Column="1"
                                                                     Margin="0,4,0,0"
                                                                     Text="{Binding ProposedVersion, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                     Visibility="{Binding ShowVersion, Converter={conv:BooleanToVisibilityConverter}}" />
                                                        </Grid>

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="{DynamicResource LOCSanitizerEdit}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerDismiss}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerApply}"
                                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>

                                            <!-- Missing-property card: list missing fields + inline date pickers -->
                                            <DataTemplate DataType="{x:Type san:MissingPropertyAction}">
                                                <Border Style="{StaticResource SanitizerCardBorder}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{DynamicResource LOCSanitizerActionMissing}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GlyphBrush}" />
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <ItemsControl ItemsSource="{Binding MissingFields}"
                                                                      Margin="0,0,0,8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource PopupBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource NormalBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="3"
                                                                            Padding="6,2"
                                                                            Margin="0,0,4,4">
                                                                        <TextBlock Text="{Binding}"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{DynamicResource LOCAcquiredDateLabel}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" />
                                                            <DatePicker Grid.Row="0" Grid.Column="1"
                                                                        SelectedDate="{Binding ProposedAcquiredDate}" />

                                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,4,0,0"
                                                                       Text="{DynamicResource LOCGameReleaseDateTitle}"
                                                                       Foreground="{DynamicResource TextBrushDarker}" />
                                                            <DatePicker Grid.Row="1" Grid.Column="1"
                                                                        Margin="0,4,0,0"
                                                                        SelectedDate="{Binding ProposedReleaseDate, Converter={pcon:ReleaseDateToNullableDateTimeConverter}}" />
                                                        </Grid>

                                                        <TextBlock Text="{DynamicResource LOCSanitizerMissingHint}"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,8" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="{DynamicResource LOCSanitizerEdit}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerDismiss}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerApply}"
                                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>

                                            <!-- Split-collection card: editable child name list -->
                                            <DataTemplate DataType="{x:Type san:SplitCollectionAction}">
                                                <Border Style="{StaticResource SanitizerCardBorder}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{DynamicResource LOCSanitizerActionSplit}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GlyphBrush}" />
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <TextBlock Margin="0,0,0,8"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextBrushDarker}">
                                                            <Run Text="{DynamicResource LOCSanitizerSplitReasonPrefix}" />
                                                            <Run Text=" " />
                                                            <Run Text="{Binding Reason, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock Text="{DynamicResource LOCSanitizerSplitChildrenLabel}"
                                                                   Margin="0,0,0,4"
                                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                                        <ItemsControl ItemsSource="{Binding ProposedChildNames}"
                                                                      Margin="0,0,0,8">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                             Margin="0,0,0,4" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="{DynamicResource LOCSanitizerSplitHint}"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,8" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="{DynamicResource LOCSanitizerEdit}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.EditGameCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerDismiss}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerApply}"
                                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>

                                            <!-- Remove-unused card: list orphaned metadata -->
                                            <DataTemplate DataType="{x:Type san:RemoveUnusedMetadataAction}">
                                                <Border Style="{StaticResource SanitizerCardBorder}">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{DynamicResource LOCSanitizerActionRemoveUnused}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GlyphBrush}" />
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>

                                                        <TextBlock Text="{DynamicResource LOCSanitizerRemoveUnusedItemsLabel}"
                                                                   Margin="0,0,0,4"
                                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                                        <ItemsControl ItemsSource="{Binding ItemNames}"
                                                                      MaxHeight="160"
                                                                      Margin="0,0,0,8">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,0,0,2" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="{DynamicResource LOCSanitizerRemoveUnusedHint}"
                                                                   FontStyle="Italic"
                                                                   Foreground="{DynamicResource TextBrushDarker}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,8" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="{DynamicResource LOCSanitizerDismiss}"
                                                                    Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource LOCSanitizerApply}"
                                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType={x:Type LibrarySanitizer}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>

                                        </ItemsControl.Resources>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={conv:BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource LOCSanitizerEmptyTitle}"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOCSanitizerEmptyHint}"
                                           Margin="0,12,0,0"
                                           MaxWidth="420"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextBrushDarker}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
